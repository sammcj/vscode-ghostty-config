{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ghostty Config",
  "patterns": [
    { "include": "#comments" },
    { "include": "#key-value" },
    { "include": "#config-directive" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ghostty",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "key-value": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z][a-zA-Z0-9_-]*)\\s*(=)\\s*(.*?)\\s*$",
          "captures": {
            "1": { "patterns": [{ "include": "#config-keys" }] },
            "2": { "name": "keyword.operator.assignment.ghostty" },
            "3": { "patterns": [{ "include": "#values" }] }
          }
        }
      ]
    },
    "config-directive": {
      "patterns": [
        {
          "match": "^\\s*(keybind)\\s*(=)\\s*(clear)\\s*$",
          "captures": {
            "1": { "name": "variable.other.property.ghostty" },
            "2": { "name": "keyword.operator.assignment.ghostty" },
            "3": { "name": "keyword.control.ghostty" }
          }
        }
      ]
    },
    "config-keys": {
      "patterns": [
        {
          "name": "variable.other.property.font.ghostty",
          "match": "(?<![\\w-])(font-codepoint-map|font-family|font-family-bold|font-family-bold-italic|font-family-italic|font-feature|font-shaping-break|font-size|font-style|font-style-bold|font-style-bold-italic|font-style-italic|font-synthetic-style|font-thicken|font-thicken-strength|font-variation|font-variation-bold|font-variation-bold-italic|font-variation-italic|freetype-load-flags)(?![\\w-])"
        },
        {
          "name": "variable.other.property.color.ghostty",
          "match": "(?<![\\w-])(background|bold-color|cursor-color|cursor-invert-fg-bg|cursor-opacity|cursor-text|faint-opacity|foreground|minimum-contrast|palette|palette-generate|palette-harmonious|search-background|search-foreground|search-selected-background|search-selected-foreground|selection-background|selection-foreground|selection-invert-fg-bg|split-divider-color|unfocused-split-fill|unfocused-split-opacity|window-titlebar-background|window-titlebar-foreground)(?![\\w-])"
        },
        {
          "name": "variable.other.property.cursor.ghostty",
          "match": "(?<![\\w-])(cursor-click-to-move|cursor-style|cursor-style-blink)(?![\\w-])"
        },
        {
          "name": "variable.other.property.mouse.ghostty",
          "match": "(?<![\\w-])(click-repeat-interval|focus-follows-mouse|middle-click-action|mouse-hide-while-typing|mouse-reporting|mouse-scroll-multiplier|mouse-shift-capture|right-click-action)(?![\\w-])"
        },
        {
          "name": "variable.other.property.window.ghostty",
          "match": "(?<![\\w-])(class|drag-handle|fullscreen|maximize|scrollbar|split-inherit-working-directory|split-preserve-zoom|tab-inherit-working-directory|title|window-colorspace|window-decoration|window-height|window-inherit-font-size|window-inherit-working-directory|window-new-tab-position|window-padding-balance|window-padding-color|window-padding-x|window-padding-y|window-position-x|window-position-y|window-save-state|window-show-tab-bar|window-step-resize|window-subtitle|window-theme|window-title-font-family|window-vsync|window-width|x11-instance-name)(?![\\w-])"
        },
        {
          "name": "variable.other.property.background.ghostty",
          "match": "(?<![\\w-])(background-blur|background-image|background-image-fit|background-image-opacity|background-image-position|background-image-repeat|background-opacity|background-opacity-cells)(?![\\w-])"
        },
        {
          "name": "variable.other.property.clipboard.ghostty",
          "match": "(?<![\\w-])(clipboard-codepoint-map|clipboard-paste-bracketed-safe|clipboard-paste-protection|clipboard-read|clipboard-trim-trailing-spaces|clipboard-write|clipboard-write-limit-bytes|copy-on-select)(?![\\w-])"
        },
        {
          "name": "variable.other.property.terminal.ghostty",
          "match": "(?<![\\w-])(abnormal-command-exit-runtime|alpha-blending|async-backend|bold-is-bright|command|enquiry-response|env|grapheme-width-method|initial-command|input|progress-style|scrollback-compression|scrollback-limit|scrollback-limit-bytes|scrollback-limit-lines|term|wait-after-command|working-directory)(?![\\w-])"
        },
        {
          "name": "variable.other.property.adjustment.ghostty",
          "match": "(?<![\\w-])(adjust-box-thickness|adjust-cell-height|adjust-cell-width|adjust-cursor-height|adjust-cursor-thickness|adjust-font-baseline|adjust-icon-height|adjust-overline-position|adjust-overline-thickness|adjust-strikethrough-position|adjust-strikethrough-thickness|adjust-underline-position|adjust-underline-thickness)(?![\\w-])"
        },
        {
          "name": "variable.other.property.keybind.ghostty",
          "match": "(?<![\\w-])(key-remap|keybind)(?![\\w-])"
        },
        {
          "name": "variable.other.property.link.ghostty",
          "match": "(?<![\\w-])(link|link-osc8|link-previews|link-url)(?![\\w-])"
        },
        {
          "name": "variable.other.property.theme.ghostty",
          "match": "(?<![\\w-])(theme)(?![\\w-])"
        },
        {
          "name": "variable.other.property.config.ghostty",
          "match": "(?<![\\w-])(command-palette-entry|config-default-files|config-file|confirm-close-surface|initial-window|quit-after-last-window-closed|quit-after-last-window-closed-delay)(?![\\w-])"
        },
        {
          "name": "variable.other.property.resize.ghostty",
          "match": "(?<![\\w-])(resize-overlay|resize-overlay-duration|resize-overlay-position)(?![\\w-])"
        },
        {
          "name": "variable.other.property.quick-terminal.ghostty",
          "match": "(?<![\\w-])(gtk-quick-terminal-layer|gtk-quick-terminal-namespace|quick-terminal-animation-duration|quick-terminal-autohide|quick-terminal-keyboard-interactivity|quick-terminal-position|quick-terminal-screen|quick-terminal-size|quick-terminal-space-behavior)(?![\\w-])"
        },
        {
          "name": "variable.other.property.shell.ghostty",
          "match": "(?<![\\w-])(shell-integration|shell-integration-features)(?![\\w-])"
        },
        {
          "name": "variable.other.property.security.ghostty",
          "match": "(?<![\\w-])(image-storage-limit|osc-color-report-format|title-report|vt-kam-allowed)(?![\\w-])"
        },
        {
          "name": "variable.other.property.shader.ghostty",
          "match": "(?<![\\w-])(custom-shader|custom-shader-animation)(?![\\w-])"
        },
        {
          "name": "variable.other.property.notification.ghostty",
          "match": "(?<![\\w-])(app-notifications|bell-audio-path|bell-audio-volume|bell-features|desktop-notifications|notify-on-command-finish|notify-on-command-finish-action|notify-on-command-finish-after)(?![\\w-])"
        },
        {
          "name": "variable.other.property.selection.ghostty",
          "match": "(?<![\\w-])(scroll-to-bottom|selection-clear-on-copy|selection-clear-on-typing|selection-word-chars)(?![\\w-])"
        },
        {
          "name": "variable.other.property.undo.ghostty",
          "match": "(?<![\\w-])(undo-timeout)(?![\\w-])"
        },
        {
          "name": "variable.other.property.macos.ghostty",
          "match": "(?<![\\w-])(macos-applescript|macos-auto-secure-input|macos-custom-icon|macos-dock-drop-behavior|macos-hidden|macos-icon|macos-icon-frame|macos-icon-ghost-color|macos-icon-screen-color|macos-non-native-fullscreen|macos-option-as-alt|macos-secure-input-indication|macos-shortcuts|macos-titlebar-proxy-icon|macos-titlebar-style|macos-window-buttons|macos-window-shadow)(?![\\w-])"
        },
        {
          "name": "variable.other.property.linux.ghostty",
          "match": "(?<![\\w-])(linux-cgroup|linux-cgroup-hard-fail|linux-cgroup-memory-limit|linux-cgroup-processes-limit)(?![\\w-])"
        },
        {
          "name": "variable.other.property.gtk.ghostty",
          "match": "(?<![\\w-])(adw-toolbar-style|gtk-adwaita|gtk-custom-css|gtk-gsk-renderer|gtk-horizontal-tab-scroll|gtk-opengl-debug|gtk-single-instance|gtk-tabs-location|gtk-titlebar|gtk-titlebar-hide-when-maximized|gtk-titlebar-style|gtk-toolbar-style|gtk-wide-tabs|language)(?![\\w-])"
        },
        {
          "name": "variable.other.property.update.ghostty",
          "match": "(?<![\\w-])(auto-update|auto-update-channel)(?![\\w-])"
        },
        {
          "name": "variable.other.property.ghostty",
          "match": "\\b[a-zA-Z][a-zA-Z0-9_-]*\\b"
        }
      ]
    },
    "values": {
      "patterns": [
        { "include": "#quoted-string" },
        { "include": "#keybind-value" },
        { "include": "#color-value" },
        { "include": "#boolean-value" },
        { "include": "#numeric-value" },
        { "include": "#path-value" },
        { "include": "#enum-value" },
        { "include": "#unquoted-value" }
      ]
    },
    "quoted-string": {
      "patterns": [
        {
          "name": "string.quoted.double.ghostty",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.ghostty", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.ghostty",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.ghostty", "match": "\\\\." }]
        }
      ]
    },
    "keybind-value": {
      "patterns": [
        {
          "match": "\\b(global:|all:|unconsumed:|performable:)?(.*?)=(?![+=])(.*?)$",
          "captures": {
            "1": { "name": "keyword.other.prefix.ghostty" },
            "2": { "patterns": [{ "include": "#keybind-trigger" }] },
            "3": { "patterns": [{ "include": "#keybind-action" }] }
          }
        }
      ]
    },
    "keybind-trigger": {
      "patterns": [
        {
          "name": "support.function.modifier.ghostty",
          "match": "\\b(shift|ctrl|control|alt|opt|option|super|cmd|command)\\b"
        },
        {
          "name": "support.function.key.ghostty",
          "match": "\\b(physical:)?\\b(up|down|left|right|home|end|page_up|page_down|insert|delete|tab|enter|escape|space|backspace|one|two|three|four|five|six|seven|eight|nine|zero|a|b|c|d|e|f|g|h|i|j|k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z|f1|f2|f3|f4|f5|f6|f7|f8|f9|f10|f11|f12|f13|f14|f15|f16|f17|f18|f19|f20)\\b"
        },
        {
          "name": "keyword.operator.sequence.ghostty",
          "match": ">"
        },
        {
          "name": "keyword.operator.plus.ghostty",
          "match": "\\+"
        }
      ]
    },
    "keybind-action": {
      "patterns": [
        {
          "name": "support.function.action.ghostty",
          "match": "\\b(ignore|unbind|csi|esc|text|cursor_key|reset|copy_to_clipboard|paste_from_clipboard|paste_from_selection|copy_url_to_clipboard|copy_title_to_clipboard|increase_font_size|decrease_font_size|reset_font_size|set_font_size|clear_screen|select_all|scroll_to_top|scroll_to_bottom|scroll_to_selection|scroll_page_up|scroll_page_down|scroll_page_fractional|scroll_page_lines|adjust_selection|jump_to_prompt|write_scrollback_file|write_screen_file|write_selection_file|new_window|new_tab|previous_tab|next_tab|last_tab|goto_tab|move_tab|toggle_tab_overview|prompt_surface_title|new_split|goto_split|toggle_split_zoom|resize_split|equalize_splits|reset_window_size|toggle_maximize|toggle_fullscreen|toggle_window_decorations|toggle_window_float_on_top|toggle_visibility|inspector|show_gtk_inspector|show_on_screen_keyboard|open_config|reload_config|close_surface|close_tab|close_window|close_all_windows|toggle_secure_input|toggle_command_palette|toggle_quick_terminal|check_for_updates|undo|redo|quit|crash)\\b"
        },
        {
          "name": "string.other.action-param.ghostty",
          "match": ":(.*?)$"
        }
      ]
    },
    "color-value": {
      "patterns": [
        {
          "name": "constant.other.color.hex.ghostty",
          "match": "#[0-9a-fA-F]{3,8}\\b"
        },
        {
          "name": "constant.other.color.hex.ghostty",
          "match": "\\b[0-9a-fA-F]{6}\\b"
        },
        {
          "name": "constant.other.color.named.ghostty",
          "match": "\\b(black|red|green|yellow|blue|magenta|cyan|white|gray|grey|darkred|darkgreen|darkyellow|darkblue|darkmagenta|darkcyan|lightgray|lightgrey|lightred|lightgreen|lightyellow|lightblue|lightmagenta|lightcyan|orange|pink|purple|brown|gold|silver|navy|maroon|olive|lime|aqua|teal|fuchsia|transparent|cell-foreground|cell-background)\\b"
        }
      ]
    },
    "boolean-value": {
      "patterns": [
        {
          "name": "constant.language.boolean.ghostty",
          "match": "\\b(true|false|yes|no|on|off)\\b"
        }
      ]
    },
    "numeric-value": {
      "patterns": [
        {
          "name": "constant.numeric.integer.ghostty",
          "match": "\\b-?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.float.ghostty",
          "match": "\\b-?[0-9]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.percentage.ghostty",
          "match": "\\b-?[0-9]+(?:\\.[0-9]+)?%\\b"
        }
      ]
    },
    "path-value": {
      "patterns": [
        {
          "name": "string.other.path.ghostty",
          "match": "\\b(/[^\\s=]*|\\./[^\\s=]*|\\?[^\\s=]*|~[^\\s=]*)\\b"
        }
      ]
    },
    "enum-value": {
      "patterns": [
        {
          "name": "constant.other.enum.cursor.ghostty",
          "match": "\\b(block|bar|underline|block_hollow)\\b"
        },
        {
          "name": "constant.other.enum.theme.ghostty",
          "match": "\\b(auto|system|light|dark|ghostty)\\b"
        },
        {
          "name": "constant.other.enum.window.ghostty",
          "match": "\\b(none|client|server|native|transparent|tabs|hidden|center|top|bottom|left|right|top-left|top-center|top-right|bottom-left|bottom-center|bottom-right|current|end|always|never|after-first|main|mouse|macos-menu-bar|move|remain|visible|flat|raised|raised-border|desktop|single-instance|default)\\b"
        },
        {
          "name": "constant.other.enum.integration.ghostty",
          "match": "\\b(detect|bash|elvish|fish|zsh|cursor|sudo|title|ssh-env|ssh-terminfo|no-cursor|no-sudo|no-title)\\b"
        },
        {
          "name": "constant.other.enum.format.ghostty",
          "match": "\\b(8-bit|16-bit|srgb|display-p3|unicode|legacy|native|linear|linear-corrected|ask|allow|deny|stable|tip|off|check|download|contain|cover|stretch|keystroke|output|context-menu|paste|copy|copy-or-paste|clipboard|toggle|show|hide|osc8)\\b"
        },
        {
          "name": "constant.other.enum.macos.ghostty",
          "match": "\\b(visible-menu|official|blueprint|chalkboard|microchip|glass|holographic|paper|retro|xray|custom-style|custom|aluminum|beige|plastic|chrome|working-directory|home|inherit)\\b"
        },
        {
          "name": "constant.other.enum.gtk.ghostty",
          "match": "\\b(overlay|background|on-demand|exclusive)\\b"
        }
      ]
    },
    "unquoted-value": {
      "patterns": [
        {
          "name": "string.unquoted.ghostty",
          "match": "[^\\s#]+"
        }
      ]
    }
  },
  "scopeName": "source.ghostty"
}
